# MCPDB Environment Variables
# Copy to .env and fill in your values.
# Loaded automatically when python-dotenv is installed.
# Real env vars always take priority over .env values.
#
# All *_KEY and *_URL variables support a _FILE suffix for Docker/K8s secrets:
#   GEMINI_API_KEY_FILE=/run/secrets/gemini_key

# LLM Provider API Keys (set at least one)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Pre-fill database connection in web UI
# MCPDB_DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/dbname

# Logging
# MCPDB_LOG_LEVEL=INFO

# Config file path (optional, default: ./mcpdb.yaml)
# MCPDB_CONFIG=/path/to/mcpdb.yaml
